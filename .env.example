# Middleware MCP Server Configuration
# Copy this file to .env and fill in your actual values

# Application mode: stdio, http, or sse
# For real (authenticated) use, HTTP mode is the only supported path — OAuth is required.
APP_MODE=http

# Server host/port (for http/sse modes)
APP_HOST=localhost
APP_PORT=8080

# Optional: public URL of the MCP endpoint, advertised in the metadata. Set this to the
# public URL when behind a proxy/ingress (the URL users paste into Claude.ai). If unset,
# it is derived from the listen address as http://<APP_HOST>:<APP_PORT>/mcp.
# MCP_SERVER_URL=https://mcp.middleware.io/mcp

# Required (http/sse): OAuth Authorization Server issuer.
# This is where Claude does login, consent, and token exchange. Advertised in the
# RFC 9728 Protected Resource Metadata so Claude can discover it from the MCP URL alone.
MW_AUTH_SERVER_URL=https://app.middleware.io

# Optional: space-separated OAuth scopes advertised in metadata + WWW-Authenticate.
MCP_SCOPES=mcp:read mcp:tools

# The MCP server decodes the access-token JWT per request and reads the `alias` claim
# (e.g. "acme"), then builds the backend data-plane URL by substituting it into the
# template below. The `alias` claim name is fixed in code — part of the contract with
# app.middleware.io.
#
# Optional: URL template; "{alias}" is replaced by the token's alias claim.
# Default: https://{alias}.middleware.io
# The alias is validated as a single DNS label (no dots/slashes), so a token can only ever
# vary the subdomain — it can't redirect the request off-domain (SSRF guard).
# For local testing against a mock backend, set a fixed URL with no placeholder, e.g.
#   MW_TENANT_BASE_URL_TEMPLATE=http://localhost:9100
MW_TENANT_BASE_URL_TEMPLATE=https://{alias}.middleware.io

# Note: per-connection tool exclusion is now controlled by the connector URL query string:
#   https://mcp.middleware.io/mcp?exclude_tools=create_dashboard,delete_dashboard
# There is no EXCLUDED_TOOLS env var anymore.
